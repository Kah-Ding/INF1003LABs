classDiagram
    class Product {
        <<abstract>>
        -__product_id : str
        -__name : str
        -__price : float
        -__stock : int
        +MAX_STOCK : int = 500
        +product_id() str
        +name() str
        +price() float
        +stock() int
        +update_stock(quantity : int) void
        +calculate_tax(quantity : int, rate : float) float
        +display_information() void
        +get_fulfilment_info()* str
    }
    class CanBeShipped {
        <<interface>>
        +calculate_shipping_cost()* float
    }
    class PhysicalProduct {
        -__weight : float
        +BASE_SHIPPING_FEE : float = 5.00
        +RATE_PER_KG : float = 2.00
        +weight() float
        +display_information() void
        +get_fulfilment_info() str
        +calculate_shipping_cost() float
    }
    class DigitalProduct {
        -__download_size : float
        +download_size() float
        +display_information() void
        +get_fulfilment_info() str
    }
    class Inventory {
        -__products : list~Product~
        +add_product(product : Product) void
        +find_by_id(product_id : str) Product
        +search_product(keyword : str) list~Product~
        +display_all() void
        +get_products() list~Product~
        +generate_next_id() str
        +total_units() int
    }
    class InventoryFileHandler {
        -__file_path : str
        +load() Inventory
        +save(inventory : Inventory) void
        -__create_product(record : dict) Product
        -__to_record(product : Product) dict
        -__write(records : list) void
    }
    Product <|-- PhysicalProduct
    Product <|-- DigitalProduct
    CanBeShipped <|.. PhysicalProduct
    Inventory "1" o-- "0..*" Product : contains
    InventoryFileHandler ..> Inventory : loads/saves
    InventoryFileHandler ..> PhysicalProduct : creates
    InventoryFileHandler ..> DigitalProduct : creates
